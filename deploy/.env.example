# Raven — konfigurasi lingkungan (copy ke .env, jangan commit)
RAVEN_ENV=development
RAVEN_HTTP_ADDR=:8080
RAVEN_PUBLIC_BASE_URL=http://localhost:8080

# Database (Postgres)
RAVEN_DATABASE_URL=postgres://raven:raven@localhost:5432/raven?sslmode=disable
RAVEN_DB_MAX_CONNS=20
RAVEN_AUTO_MIGRATE=true
RAVEN_WAIT_FOR_DB=30s
RAVEN_SHUTDOWN_TIMEOUT=15s

# Keamanan
RAVEN_LOG_LEVEL=info
RAVEN_JWT_SECRET=dev-insecure-change-me
RAVEN_ACCESS_TOKEN_TTL=15m
RAVEN_REFRESH_TOKEN_TTL=720h

# TLS: produksi wajib salah satu dari dua ini
RAVEN_TLS_TERMINATED=false
RAVEN_ALLOW_INSECURE_HTTP=false

# Rate limit
RAVEN_RATE_LIMIT_ENABLED=true
RAVEN_RATE_LIMIT_RPS=50
RAVEN_RATE_LIMIT_BURST=100

# Body & save
RAVEN_MAX_BODY_BYTES=1048576
RAVEN_SAVE_MAX_BYTES=1048576
RAVEN_SAVE_VERSIONS=5
RAVEN_BLOB_DIR=./data/blobs

# CORS (pisah koma)
RAVEN_CORS_ORIGINS=
RAVEN_TRUSTED_PROXIES=
